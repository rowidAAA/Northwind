@model Northwind.DAL.Models.Shippers

<div class="modal-header">
    <h5 class="modal-title">Delete Shipper</h5>
    <button type="button" class="btn-close js-modal-close"></button>
</div>
@using (Html.BeginForm("Delete", "Shipper"))
{
    @Html.AntiForgeryToken()
    @Html.Hidden("id", Model.ShipperID)
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    <div class="modal-body">
        <p class="mb-0">Are you sure you want to delete <strong>@Model.CompanyName</strong>?</p>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-secondary js-modal-close">Cancel</button>
        <button type="submit" class="btn btn-danger">Delete</button>
    </div>
}
