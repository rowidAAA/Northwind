@model IEnumerable<Northwind.DAL.Models.Shippers>
@{
    ViewBag.Title = "Shippers";
}
<div class="page-header">
    <h2>Shippers</h2>
    <a href="#" id="createLink" class="btn btn-primary">+ New Shipper</a>
</div>

<div class="card card-table">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0" id="shippersTable">
            <thead>
                <tr>
                    <th>@Html.DisplayNameFor(model => model.CompanyName)</th>
                    <th>@Html.DisplayNameFor(model => model.Phone)</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@Html.DisplayFor(modelItem => item.CompanyName)</td>
                        <td>@Html.DisplayFor(modelItem => item.Phone)</td>
                        <td class="text-end text-nowrap">
                            <a href="#" class="btn btn-sm btn-primary editLink" data-id="@item.ShipperID">Edit</a>
                            <a href="#" class="btn btn-sm btn-danger deleteLink" data-id="@item.ShipperID">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="shipperModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content" id="shipperModalContent"></div>
    </div>
</div>

@section scripts {
    <script>
        var shipperModalEl = document.getElementById('shipperModal');
        var shipperModal = new bootstrap.Modal(shipperModalEl);

        $(function () {
            $(document).on('click', '#createLink', function (e) {
                e.preventDefault();
                $.get('@Url.Action("Create")', function (data) {
                    $('#shipperModalContent').html(data);
                    shipperModal.show();
                });
            });

            $(document).on('click', '.editLink', function (e) {
                e.preventDefault();
                var id = $(this).data('id');
                $.get('@Url.Action("Edit")/' + id, function (data) {
                    $('#shipperModalContent').html(data);
                    shipperModal.show();
                });
            });

            $(document).on('click', '.deleteLink', function (e) {
                e.preventDefault();
                var id = $(this).data('id');
                $.get('@Url.Action("Delete")/' + id, function (data) {
                    $('#shipperModalContent').html(data);
                    shipperModal.show();
                });
            });

            $(document).on('submit', '#shipperModalContent form', function (e) {
                e.preventDefault();
                var form = $(this);
                $.ajax({
                    url: form.attr('action'),
                    type: 'POST',
                    data: form.serialize(),
                    statusCode: {
                        200: function () {
                            shipperModal.hide();
                            location.reload();
                        },
                        400: function (xhr) {
                            $('#shipperModalContent').html(xhr.responseText);
                        }
                    }
                });
            });

            $(document).on('click', '.js-modal-close', function (e) {
                e.preventDefault();
                shipperModal.hide();
            });
        });
    </script>
}
