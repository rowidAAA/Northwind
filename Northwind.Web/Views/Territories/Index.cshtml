@model IEnumerable<Northwind.DAL.Models.Territory>
@{
    ViewBag.Title = "Index";
}
<div class="page-header">
    <h2>Territories</h2>
    <a href="#" id="createLink" class="btn btn-primary">+ New Territory</a>
</div>

<div class="mb-3" style="max-width: 340px">
    <input type="search" class="form-control" data-table-filter="#territoriesTable" placeholder="Search territories..." />
</div>

<div class="card card-table">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0" id="territoriesTable">
            <thead>
                <tr>
                    <th>@Html.DisplayNameFor(model => model.TerritoryDescription)</th>
                    <th>Region</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@Html.DisplayFor(modelItem => item.TerritoryDescription)</td>
                        <td>@(item.Region?.RegionDescription)</td>
                        <td class="text-end text-nowrap">
                            <a href="#" class="btn btn-sm btn-primary editLink" data-id="@item.TerritoryID">Edit</a>
                            <a href="#" class="btn btn-sm btn-danger deleteLink" data-id="@item.TerritoryID">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal shell -->
<div class="modal fade" id="territoryModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content" id="territoryModalContent">
            <!-- AJAX content gets injected here -->
        </div>
    </div>
</div>

@section scripts {
    <script>
        var territoryModalEl = document.getElementById('territoryModal');
        var territoryModal = new bootstrap.Modal(territoryModalEl);

        $(function () {
            // Open modal with Create form
            $(document).on('click', '#createLink', function (e) {
                e.preventDefault();
                $.get('@Url.Action("Create")', function (data) {
                    $('#territoryModalContent').html(data);
                    territoryModal.show();
                });
            });

            // Open modal with Edit form
$(document).on('click', '.editLink', function (e) {
    e.preventDefault();
    var id = $(this).data('id');
    $.get('@Url.Action("Edit")/' + id, function (data) {  
        $('#territoryModalContent').html(data);
        territoryModal.show();
    });
});

            // Open modal with Delete confirmation
            $(document).on('click', '.deleteLink', function (e) {
                e.preventDefault();
                var id = $(this).data('id');
                $.get('@Url.Action("Delete")/' + id, function (data) {
                    $('#territoryModalContent').html(data);
                    territoryModal.show();
                });
            });

            // Submit Edit/Delete form via AJAX
            $(document).on('submit', '#territoryModalContent form', function (e) {
                e.preventDefault();
                var form = $(this);
                $.post(form.attr('action'), form.serialize(), function () {
                    territoryModal.hide();
                    location.reload();
                });
            });

            // Manual close handler
            $(document).on('click', '.js-modal-close', function (e) {
                e.preventDefault();
                territoryModal.hide();
            });
        });
    </script>
}