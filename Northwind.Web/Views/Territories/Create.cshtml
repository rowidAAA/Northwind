                @Html.EditorFor(model => model.TerritoryDescription)
                @Html.ValidationMessageFor(model => model.TerritoryDescription, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="form-group">
            @Html.LabelFor(model => model.RegionID, htmlAttributes: new { @class = "control-label col-md-2" })
