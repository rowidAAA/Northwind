@model Northwind.DAL.Models.Territory
<div class="modal-header">
    <button type="button" class="close js-modal-close">&times;</button>
    <h4>Update Territory</h4>
</div>
@using (Html.BeginForm("Edit", "Territories"))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(model => model.TerritoryID)
    <div class="modal-body">
        <div class="form-group">
            @Html.LabelFor(model => model.TerritoryDescription)
            @Html.EditorFor(model => model.TerritoryDescription, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(model => model.TerritoryDescription, "", new { @class = "text-danger" })
        </div>
        <div class="form-group">
            @Html.LabelFor(model => model.RegionID)
            @Html.DropDownListFor(model => model.RegionID, (SelectList)ViewBag.RegionID, new { @class = "form-control" })
            @Html.ValidationMessageFor(model => model.RegionID, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="modal-footer">
        <button type="submit" class="btn btn-primary">Update</button>
        <button type="button" class="btn btn-default js-modal-close">Cancel</button>
    </div>
}