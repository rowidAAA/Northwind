<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Northwind Traders</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark app-navbar shadow-sm">
        <div class="container">
            @Html.ActionLink("Northwind Traders", "Index", "Home", null, new { @class = "navbar-brand fw-bold" })
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                    aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <nav style="display:flex; gap:20px; font-size:14px;">
                @Html.ActionLink("Region", "Index", "Regions", null, new { @class = "nav-link" })
                @Html.ActionLink("Territory", "Index", "Territories", null, new { @class = "nav-link" })
                @Html.ActionLink("Category", "Index", "Category", null, new { @class = "nav-link" })
                @Html.ActionLink("Supplier", "Index", "Supplier", null, new { @class = "nav-link" })
                @Html.ActionLink("Product", "Index", "Product", null, new { @class = "nav-link" })
                @Html.ActionLink("Customer", "Index", "Customer", null, new { @class = "nav-link" })
                @Html.ActionLink("Employee", "Index", "Employee", null, new { @class = "nav-link" })
                @Html.ActionLink("Shipper", "Index", "Shipper", null, new { @class = "nav-link" })
                @Html.ActionLink("Order", "Index", "Order", null, new { @class = "nav-link" })
            </nav>
        </div>
    </nav>

    <main class="container body-content">
        @if (ViewContext.RouteData.Values["controller"]?.ToString() != "Home")
        {
            <div class="mb-3">
                <a href="@Url.Action("Index", "Home")" class="btn btn-sm btn-outline-secondary">&larr; Back to Home</a>
            </div>
        }
        @RenderBody()
    </main>

    <footer class="app-footer">
        <div class="container text-center">
            <span>&copy; @DateTime.Now.Year Northwind Traders</span>
        </div>
    </footer>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/jqueryval")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
    <script>
        // Client-side rule for the RequiredTrimmed attribute (rejects whitespace-only strings)
        if (window.jQuery && jQuery.validator) {
            jQuery.validator.addMethod('requiredtrimmed', function (value, element) {
                return value !== undefined && value !== null && jQuery.trim(value).length > 0;
            });
            jQuery.validator.unobtrusive.adapters.addBool('requiredtrimmed');

            // Client-side rule for the PhoneNumber attribute (rejects letters and other non-phone characters)
            jQuery.validator.addMethod('phonenumber', function (value, element) {
                if (!value || jQuery.trim(value).length === 0) return true; // optional field
                return /^[0-9+\-().\s]+$/.test(value);
            });
            jQuery.validator.unobtrusive.adapters.addBool('phonenumber');

            // Client-side rule for the DigitsOnly attribute (rejects anything that is not a digit)
            jQuery.validator.addMethod('digitsonly', function (value, element) {
                if (!value || jQuery.trim(value).length === 0) return true; // optional field
                return /^[0-9]+$/.test(value);
            });
            jQuery.validator.unobtrusive.adapters.addBool('digitsonly');
        }

        // Enforce maxlength from validation metadata (data-val-length-max)
        function applyMaxLength(scope) {
            scope.find('input[data-val-length-max], textarea[data-val-length-max]').each(function () {
                var $el = $(this);
                if (!$el.attr('maxlength')) {
                    $el.attr('maxlength', $el.attr('data-val-length-max'));
                }
            });
        }

        // Live search filter for any table: <input data-table-filter="#tableId">
        $(document).on('input', '[data-table-filter]', function () {
            var q = $(this).val().toLowerCase();
            $($(this).data('table-filter') + ' tbody tr').each(function () {
                $(this).toggle($(this).text().toLowerCase().indexOf(q) > -1);
            });
        });

        $(function () {
            applyMaxLength($(document));
            // Validate + apply maxlength to forms injected into modals via AJAX
            $(document).on('shown.bs.modal', '.modal', function () {
                if (window.jQuery && jQuery.validator && jQuery.validator.unobtrusive) {
                    jQuery.validator.unobtrusive.parse($(this));
                }
                applyMaxLength($(this));
            });
        });
    </script>
</body>
</html>
