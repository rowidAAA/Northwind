@{
    ViewBag.Title = "Dashboard";
}

<h2>Dashboard</h2>
<p class="text-muted">Manage products, customers, and orders across Northwind Traders.</p>

<div class="row mb-4">
    <div class="col-md-3">
        <div class="card p-3">
            <div class="text-muted small">Open orders</div>
            <div class="fs-4 fw-bold">@ViewBag.OrderCount</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card p-3">
            <div class="text-muted small">Products</div>
            <div class="fs-4 fw-bold">@ViewBag.ProductCount</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card p-3">
            <div class="text-muted small">Customers</div>
            <div class="fs-4 fw-bold">@ViewBag.CustomerCount</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card p-3">
            <div class="text-muted small">Low stock</div>
            <div class="fs-4 fw-bold text-danger">@ViewBag.LowStockCount</div>
        </div>
    </div>
</div>

<p class="text-muted small mb-2">Modules</p>
<div class="row g-3">

    <div class="col-md-3">
        <a href="@Url.Action("Index","Regions")" class="text-decoration-none text-body">
            <div class="card p-3 h-100">
                <div class="fw-bold">Region</div>
                <div class="text-muted small">@ViewBag.RegionCount regions</div>
            </div>
        </a>
    </div>

    <div class="col-md-3">
        <a href="@Url.Action("Index","Territories")" class="text-decoration-none text-body">
            <div class="card p-3 h-100">
                <div class="fw-bold">Territory</div>
                <div class="text-muted small">@ViewBag.TerritoryCount territories</div>
            </div>
        </a>
    </div>

    <div class="col-md-3">
        <a href="@Url.Action("Index","Category")" class="text-decoration-none text-body">
            <div class="card p-3 h-100">
                <div class="fw-bold">Category</div>
                <div class="text-muted small">@ViewBag.CategoryCount categories</div>
            </div>
        </a>
    </div>

    <div class="col-md-3">
        <a href="@Url.Action("Index","Supplier")" class="text-decoration-none text-body">
            <div class="card p-3 h-100">
                <div class="fw-bold">Supplier</div>
                <div class="text-muted small">@ViewBag.SupplierCount suppliers</div>
            </div>
        </a>
    </div>

    <div class="col-md-3">
        <a href="@Url.Action("Index","Product")" class="text-decoration-none text-body">
            <div class="card p-3 h-100">
                <div class="fw-bold">Product</div>
                <div class="text-muted small">@ViewBag.ProductCount products</div>
            </div>
        </a>
    </div>

    <div class="col-md-3">
        <a href="@Url.Action("Index","Customer")" class="text-decoration-none text-body">
            <div class="card p-3 h-100">
                <div class="fw-bold">Customer</div>
                <div class="text-muted small">@ViewBag.CustomerCount customers</div>
            </div>
        </a>
    </div>

    <div class="col-md-3">
        <a href="@Url.Action("Index","Employee")" class="text-decoration-none text-body">
            <div class="card p-3 h-100">
                <div class="fw-bold">Employee</div>
                <div class="text-muted small">@ViewBag.EmployeeCount employees</div>
            </div>
        </a>
    </div>

    <div class="col-md-3">
        <a href="@Url.Action("Index","Shipper")" class="text-decoration-none text-body">
            <div class="card p-3 h-100">
                <div class="fw-bold">Shipper</div>
                <div class="text-muted small">@ViewBag.ShipperCount shippers</div>
            </div>
        </a>
    </div>

    <div class="col-md-3">
        <a href="@Url.Action("Index","Order")" class="text-decoration-none text-body">
            <div class="card p-3 h-100">
                <div class="fw-bold">Order</div>
                <div class="text-muted small">In progress</div>
            </div>
        </a>
    </div>

</div>