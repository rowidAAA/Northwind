@model Northwind.DAL.Models.EmployeeTerritory

<div class="modal-header">
    <h5 class="modal-title">Delete Assignment</h5>
    <button type="button" class="btn-close js-modal-close"></button>
</div>
@using (Html.BeginForm("Delete", "EmployeeTerritories"))
{
    @Html.AntiForgeryToken()
    @Html.Hidden("employeeId", Model.EmployeeID)
    @Html.Hidden("territoryId", Model.TerritoryID)
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    <div class="modal-body">
        <p class="mb-0">
            Are you sure you want to remove
            <strong>@(Model.Employee != null ? Model.Employee.LastName + ", " + Model.Employee.FirstName : Model.EmployeeID.ToString())</strong>
            from territory <strong>@(Model.Territory?.TerritoryDescription ?? Model.TerritoryID)</strong>?
        </p>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-secondary js-modal-close">Cancel</button>
        <button type="submit" class="btn btn-danger">Delete</button>
    </div>
}
