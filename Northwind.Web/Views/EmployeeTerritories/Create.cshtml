@model Northwind.DAL.Models.EmployeeTerritory

<div class="modal-header">
    <h5 class="modal-title">Assign Territory</h5>
    <button type="button" class="btn-close js-modal-close"></button>
</div>
@using (Html.BeginForm("Create", "EmployeeTerritories"))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    <div class="modal-body">
        <div class="mb-3">
            <label class="form-label">Employee</label>
            @Html.DropDownList("EmployeeID", (SelectList)ViewBag.EmployeeID, "-- Select Employee --", new { @class = "form-select" })
            @Html.ValidationMessageFor(m => m.EmployeeID, "", new { @class = "text-danger" })
        </div>
        <div class="mb-3">
            <label class="form-label">Territory</label>
            @Html.DropDownList("TerritoryID", (SelectList)ViewBag.TerritoryID, "-- Select Territory --", new { @class = "form-select" })
            @Html.ValidationMessageFor(m => m.TerritoryID, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-secondary js-modal-close">Cancel</button>
        <button type="submit" class="btn btn-primary">Save</button>
    </div>
}
