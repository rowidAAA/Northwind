@model IEnumerable<Northwind.DAL.Models.Employees>
@{
    ViewBag.Title = "Employees";
}
<div class="page-header">
    <h2>Employees</h2>
    <a href="#" id="createLink" class="btn btn-primary">+ New Employee</a>
</div>

<div class="mb-3" style="max-width: 340px">
    <input type="search" class="form-control" data-table-filter="#employeesTable" placeholder="Search employees..." />
</div>

<div class="card card-table">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0" id="employeesTable">
            <thead>
                <tr>
                    <th>@Html.DisplayNameFor(model => model.LastName)</th>
                    <th>@Html.DisplayNameFor(model => model.FirstName)</th>
                    <th>@Html.DisplayNameFor(model => model.Title)</th>
                    <th>@Html.DisplayNameFor(model => model.City)</th>
                    <th>@Html.DisplayNameFor(model => model.Country)</th>
                    <th>@Html.DisplayNameFor(model => model.HomePhone)</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@Html.DisplayFor(modelItem => item.LastName)</td>
                        <td>@Html.DisplayFor(modelItem => item.FirstName)</td>
                        <td>@Html.DisplayFor(modelItem => item.Title)</td>
                        <td>@Html.DisplayFor(modelItem => item.City)</td>
                        <td>@Html.DisplayFor(modelItem => item.Country)</td>
                        <td>@Html.DisplayFor(modelItem => item.HomePhone)</td>
                        <td class="text-end text-nowrap">
                            <a href="#" class="btn btn-sm btn-primary editLink" data-id="@item.EmployeeID">Edit</a>
                            <a href="#" class="btn btn-sm btn-danger deleteLink" data-id="@item.EmployeeID">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="employeeModal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content" id="employeeModalContent"></div>
    </div>
</div>

@section scripts {
    <script>
        var employeeModalEl = document.getElementById('employeeModal');
        var employeeModal = new bootstrap.Modal(employeeModalEl);

        $(function () {
            $(document).on('click', '#createLink', function (e) {
                e.preventDefault();
                $.get('@Url.Action("Create")', function (data) {
                    $('#employeeModalContent').html(data);
                    employeeModal.show();
                });
            });

            $(document).on('click', '.editLink', function (e) {
                e.preventDefault();
                var id = $(this).data('id');
                $.get('@Url.Action("Edit")/' + id, function (data) {
                    $('#employeeModalContent').html(data);
                    employeeModal.show();
                });
            });

            $(document).on('click', '.deleteLink', function (e) {
                e.preventDefault();
                var id = $(this).data('id');
                $.get('@Url.Action("Delete")/' + id, function (data) {
                    $('#employeeModalContent').html(data);
                    employeeModal.show();
                });
            });

            $(document).on('submit', '#employeeModalContent form', function (e) {
                e.preventDefault();
                var form = $(this);
                $.ajax({
                    url: form.attr('action'),
                    type: 'POST',
                    data: form.serialize(),
                    statusCode: {
                        200: function () {
                            employeeModal.hide();
                            location.reload();
                        },
                        400: function (xhr) {
                            $('#employeeModalContent').html(xhr.responseText);
                        }
                    }
                });
            });

            $(document).on('click', '.js-modal-close', function (e) {
                e.preventDefault();
                employeeModal.hide();
            });
        });
    </script>
}
