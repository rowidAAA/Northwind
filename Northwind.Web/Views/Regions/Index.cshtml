@model IEnumerable<Northwind.DAL.Models.Region>
@{
    ViewBag.Title = "Index";
}
<div class="page-header">
    <h2>Regions</h2>
    <a href="#" id="createLink" class="btn btn-primary">+ New Region</a>
</div>

<div class="card card-table">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0" id="regionsTable">
            <thead>
                <tr>
                    <th>@Html.DisplayNameFor(model => model.RegionDescription)</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@Html.DisplayFor(modelItem => item.RegionDescription)</td>
                        <td class="text-end text-nowrap">
                            <a href="#" class="btn btn-sm btn-primary editLink" data-id="@item.RegionID">Edit</a>
                            <a href="#" class="btn btn-sm btn-danger deleteLink" data-id="@item.RegionID">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
<div class="modal fade" id="regionModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content" id="regionModalContent"></div>
    </div>
</div>

@section scripts {
    <script>
        var regionModalEl = document.getElementById('regionModal');
        var regionModal = new bootstrap.Modal(regionModalEl);

        $(function () {
            $(document).on('click', '#createLink', function (e) {
                e.preventDefault();
                $.get('@Url.Action("Create")', function (data) {
                    $('#regionModalContent').html(data);
                    regionModal.show();
                });
            });

            $(document).on('click', '.editLink', function (e) {
                e.preventDefault();
                var id = $(this).data('id');
                $.get('@Url.Action("Update")/' + id, function (data) {
                    $('#regionModalContent').html(data);
                    regionModal.show();
                });
            });

            $(document).on('click', '.deleteLink', function (e) {
                e.preventDefault();
                var id = $(this).data('id');
                $.get('@Url.Action("Delete")/' + id, function (data) {
                    $('#regionModalContent').html(data);
                    regionModal.show();
                });
            });

            // Submit — reload on success (200), re-render modal content on validation failure (400)
            $(document).on('submit', '#regionModalContent form', function (e) {
                e.preventDefault();
                var form = $(this);
                $.ajax({
                    url: form.attr('action'),
                    type: 'POST',
                    data: form.serialize(),
                    statusCode: {
                        200: function () {
                            regionModal.hide();
                            location.reload();
                        },
                        400: function (xhr) {
                            $('#regionModalContent').html(xhr.responseText);
                        }
                    }
                });
            });

            $(document).on('click', '.js-modal-close', function (e) {
                e.preventDefault();
                regionModal.hide();
            });
        });
    </script>
}