@model Northwind.DAL.Models.Region
<div class="modal-header">
    <button type="button" class="close js-modal-close">&times;</button>
    <h4>Delete Region</h4>
</div>
<div class="modal-body">
    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger">@ViewBag.ErrorMessage</div>
    }
    <p>Are you sure you want to delete <strong>@Model.RegionDescription</strong>?</p>
</div>
@using (Html.BeginForm("Delete", "Regions"))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(model => model.RegionID)
    <div class="modal-footer">
        <button type="submit" class="btn btn-danger">Delete</button>
        <button type="button" class="btn btn-default js-modal-close">Cancel</button>
    </div>
}