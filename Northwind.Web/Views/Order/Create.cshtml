@model Northwind.DAL.Models.Order

<div class="page-header">
    <h2>New Order</h2>
    <a href="@Url.Action("Index", "Order")" class="btn btn-outline-secondary">&larr; Back to Orders</a>
</div>

@using (Html.BeginForm("Create", "Order"))
{
    @Html.ValidationSummary(true)

    <div class="mb-3">
        <label class="form-label">Order ID</label>
        <input type="text" class="form-control" value="(assigned after save)" disabled />
    </div>

    <div class="mb-3">
        <label class="form-label">Company Name</label>
        @Html.DropDownList("CustomerID", (SelectList)ViewBag.CustomerID, "-- Select Customer --", new { @class = "form-select" })
        @Html.ValidationMessageFor(m => m.CustomerID, "", new { @class = "text-danger" })
    </div>

    <div class="mb-3">
        <label class="form-label">Employee</label>
        @Html.DropDownList("EmployeeID", (SelectList)ViewBag.EmployeeID, "-- Select Employee --", new { @class = "form-select" })
    </div>

    <div class="mb-3">
        <label class="form-label">Shipper</label>
        @Html.DropDownList("ShipVia", (SelectList)ViewBag.ShipVia, "-- Select Shipper --", new { @class = "form-select" })
    </div>

    <div class="mb-3">
        @Html.LabelFor(m => m.OrderDate, new { @class = "form-label" })
        @Html.TextBoxFor(m => m.OrderDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
        @Html.ValidationMessageFor(m => m.OrderDate, "", new { @class = "text-danger" })
    </div>

    <div class="mb-3">
        @Html.LabelFor(m => m.RequiredDate, new { @class = "form-label" })
        @Html.TextBoxFor(m => m.RequiredDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
        @Html.ValidationMessageFor(m => m.RequiredDate, "", new { @class = "text-danger" })
    </div>

    <div class="mb-3">
        @Html.LabelFor(m => m.Freight, new { @class = "form-label" })
        @Html.TextBoxFor(m => m.Freight, new { @class = "form-control", type = "number", step = "0.01", min = "0" })
        @Html.ValidationMessageFor(m => m.Freight, "", new { @class = "text-danger" })
    </div>

    <div class="mb-3">
        @Html.LabelFor(m => m.ShipName, new { @class = "form-label" })
        @Html.TextBoxFor(m => m.ShipName, new { @class = "form-control" })
    </div>
    <div class="mb-3">
        @Html.LabelFor(m => m.ShipAddress, new { @class = "form-label" })
        @Html.TextBoxFor(m => m.ShipAddress, new { @class = "form-control" })
    </div>
    <div class="mb-3">
        @Html.LabelFor(m => m.ShipCity, new { @class = "form-label" })
        @Html.TextBoxFor(m => m.ShipCity, new { @class = "form-control" })
    </div>
    <div class="mb-3">
        @Html.LabelFor(m => m.ShipCountry, new { @class = "form-label" })
        @Html.TextBoxFor(m => m.ShipCountry, new { @class = "form-control" })
    </div>

    <button type="submit" class="btn btn-primary">Save Order</button>
}