@model Northwind.DAL.Models.Order

<h2>Order #@Model.OrderID</h2>

<a href="@Url.Action("Index", "Order")" class="btn btn-secondary mb-3">Back to Orders</a>

<div class="row mb-4">
    <div class="col-md-4">
        <label class="form-label">Order ID</label>
        <input type="text" class="form-control" value="@Model.OrderID" disabled />
    </div>
    <div class="col-md-4">
        <label class="form-label">Company</label>
        <input type="text" class="form-control" value="@(Model.Customer?.CompanyName)" disabled />
    </div>
    <div class="col-md-4">
        <label class="form-label">Order Date</label>
        <input type="text" class="form-control" value="@(Model.OrderDate?.ToString("d"))" disabled />
    </div>
</div>

<button type="button" id="addProductLink" class="btn btn-success mb-3" data-order-id="@Model.OrderID">
    Add Product
</button>

<table class="table" id="orderDetailsGrid">
    <thead>
        <tr><th>Product</th><th>Qty</th><th>Unit Price</th><th>Discount</th><th>Line Total</th><th></th></tr>
    </thead>
    <tbody>
        @foreach (var d in Model.OrderDetails)
        {
            <tr>
                <td>@(d.Product?.ProductName)</td>
                <td>@d.Quantity</td>
                <td>@d.UnitPrice.ToString("C")</td>
                <td>@d.Discount.ToString("P0")</td>
                <td>@((d.UnitPrice * d.Quantity * (1 - (decimal)d.Discount)).ToString("C"))</td>
                <td>
                    <a href="#" class="deleteDetailLink" data-order-id="@d.OrderID" data-product-id="@d.ProductID">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="modal fade" id="detailModal">
    <div class="modal-dialog">
        <div class="modal-content" id="detailModalContent"></div>
    </div>
</div>

@section scripts {
    <script>
    var detailModal = new bootstrap.Modal(document.getElementById('detailModal'));

    $('#addProductLink').on('click', function () {
        var orderId = $(this).data('order-id');
        $.get('@Url.Action("Create", "OrderDetail")', { orderId: orderId }, function (html) {
            $('#detailModalContent').html(html);
            detailModal.show();
        });
    });

    $(document).on('change', '#ProductID', function () {
        var price = $(this).find(':selected').data('price');
        if (price !== undefined) { $('#UnitPrice').val(price); }
    });

    $(document).on('submit', '#detailModalContent form', function (e) {
        e.preventDefault();
        $.ajax({
            url: this.action,
            type: 'POST',
            data: $(this).serialize(),
            statusCode: {
                200: function () { detailModal.hide(); location.reload(); },
                400: function (xhr) { $('#detailModalContent').html(xhr.responseText); }
            }
        });
    });

    $(document).on('click', '.js-modal-close', function () { detailModal.hide(); });

    $('.deleteDetailLink').on('click', function (e) {
        e.preventDefault();
        var orderId = $(this).data('order-id');
        var productId = $(this).data('product-id');
        if (confirm('Remove this product from the order?')) {
            $.post('@Url.Action("Delete", "OrderDetail")', { orderId: orderId, productId: productId })
                .done(function () { location.reload(); });
        }
    });
    </script>
}